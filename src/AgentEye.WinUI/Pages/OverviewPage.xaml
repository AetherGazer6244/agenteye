<UserControl
    x:Class="AgentEye.WinUI.Pages.OverviewPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Padding="20,12,20,12" RowSpacing="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" x:Name="TxtOverviewTitle" FontSize="18" FontWeight="SemiBold" />

        <Grid Grid.Row="1">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="8">

                    <!-- 代理兜底横幅:系统代理判死、已自动改直连时提示(平时不占位) -->
                    <Border x:Name="ProxyBanner" Visibility="Collapsed"
                            Background="{ThemeResource AeCardBrush}"
                            BorderBrush="{ThemeResource AeCardStrokeBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="12,10">
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Grid.Column="0" FontFamily="Segoe Fluent Icons"
                                      FontSize="14" Glyph="&#xE7BA;"
                                      Foreground="{ThemeResource AeErrorBrush}" />
                            <TextBlock Grid.Column="1" x:Name="BannerText" FontSize="12"
                                       TextWrapping="Wrap" VerticalAlignment="Center"
                                       Foreground="{ThemeResource AeTextSecondaryBrush}" />
                            <Button Grid.Column="2" x:Name="BtnProxyRetry"
                                    VerticalAlignment="Center" />
                        </Grid>
                    </Border>

                    <StackPanel x:Name="RowsHost" Spacing="8" />
                </StackPanel>
            </ScrollViewer>

            <!-- 空态(暂停/刷新入口在窗口头部图标,这里只引导去设置) -->
            <StackPanel x:Name="EmptyState" Spacing="10"
                        VerticalAlignment="Center" HorizontalAlignment="Center"
                        Visibility="Collapsed">
                <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}"
                          FontSize="26" Glyph="&#xE710;"
                          Foreground="{ThemeResource AeTextSecondaryBrush}"
                          HorizontalAlignment="Center" />
                <TextBlock x:Name="TxtEmpty" Foreground="{ThemeResource AeTextSecondaryBrush}" />
                <Button x:Name="BtnOpenSettings" Click="OpenSettings_Click" />
            </StackPanel>
        </Grid>

        <!-- 页脚:刷新时间 + 数量,各做成小胶囊(底部视觉锚点;两列自适应,窄窗口不打架) -->
        <Grid Grid.Row="2" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" CornerRadius="4" Padding="8,3"
                    Background="{ThemeResource AeSubtleFillBrush}"
                    HorizontalAlignment="Left">
                <TextBlock x:Name="FooterUpdated" FontSize="11"
                           Foreground="{ThemeResource AeTextSecondaryBrush}"
                           TextTrimming="CharacterEllipsis" />
            </Border>
            <Border Grid.Column="1" CornerRadius="4" Padding="8,3"
                    Background="{ThemeResource AeSubtleFillBrush}">
                <TextBlock x:Name="FooterCount" FontSize="11"
                           Foreground="{ThemeResource AeTextSecondaryBrush}" />
            </Border>
        </Grid>
    </Grid>
</UserControl>
