<UserControl
    x:Class="AgentEye.WinUI.Pages.OverviewPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Padding="20,12,20,12" RowSpacing="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" x:Name="TxtOverviewTitle" FontSize="20" FontWeight="SemiBold" />

        <Grid Grid.Row="1">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="RowsHost" Spacing="10" />
            </ScrollViewer>

            <!-- 空态(暂停/刷新入口在窗口头部图标,这里只引导去设置) -->
            <StackPanel x:Name="EmptyState" Spacing="10"
                        VerticalAlignment="Center" HorizontalAlignment="Center"
                        Visibility="Collapsed">
                <TextBlock x:Name="TxtEmpty" Foreground="{ThemeResource AeTextSecondaryBrush}" />
                <Button x:Name="BtnOpenSettings" Click="OpenSettings_Click" />
            </StackPanel>
        </Grid>

        <!-- 页脚:刷新时间 + 数量(两列自适应,窄窗口不打架) -->
        <Grid Grid.Row="2" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="FooterUpdated" Grid.Column="0" FontSize="11"
                       Foreground="{ThemeResource AeTextSecondaryBrush}"
                       TextTrimming="CharacterEllipsis" />
            <TextBlock x:Name="FooterCount" Grid.Column="1" FontSize="11"
                       Foreground="{ThemeResource AeTextSecondaryBrush}" />
        </Grid>
    </Grid>
</UserControl>
