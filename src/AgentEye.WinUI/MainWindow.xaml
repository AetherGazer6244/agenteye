<Window
    x:Class="AgentEye.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="AgentEye">

    <Window.SystemBackdrop>
        <DesktopAcrylicBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="Root" Loaded="Root_Loaded">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Acrylic 底层跟系统主题,这层罩保证手选浅/深时观感一致 -->
        <Border Grid.RowSpan="2"
                Background="{ThemeResource AeGlassTintBrush}"
                IsHitTestVisible="False" />

        <!-- 自绘标题栏:左标题,右图标按钮组(拖拽区交给 SetTitleBar) -->
        <Grid x:Name="AppTitleBar" Background="Transparent">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal"
                        VerticalAlignment="Center" Margin="16,0,8,0">
                <Ellipse Width="12" Height="12" Margin="0,0,8,0"
                         Fill="{ThemeResource AccentFillColorDefaultBrush}" />
                <TextBlock x:Name="AppTitle" Text="AgentEye" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" />
            </StackPanel>

            <StackPanel x:Name="HeaderButtons" Grid.Column="1" Orientation="Horizontal"
                        VerticalAlignment="Center" HorizontalAlignment="Right">
                <Button x:Name="BtnBack" Style="{StaticResource AeIconButtonStyle}"
                        Click="BtnBack_Click" Visibility="Collapsed">
                    <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}"
                              FontSize="14" Glyph="&#xE72B;" />
                </Button>
                <Button x:Name="BtnSettings" Style="{StaticResource AeIconButtonStyle}"
                        Click="BtnSettings_Click">
                    <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}"
                              FontSize="14" Glyph="&#xE713;" />
                </Button>
            </StackPanel>
        </Grid>

        <!-- 页面承载:总览/设置叠放,靠可见性切换 -->
        <Grid x:Name="PageHost" Grid.Row="1" />
    </Grid>
</Window>
