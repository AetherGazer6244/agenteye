<Window
    x:Class="AgentEye.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="AgentEye">

    <Window.SystemBackdrop>
        <DesktopAcrylicBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="Root" Loaded="Root_Loaded">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Acrylic 底层跟系统主题,这层罩保证手选浅/深时观感一致 -->
        <Border Grid.RowSpan="2"
                Background="{ThemeResource AeGlassTintBrush}"
                IsHitTestVisible="False" />

        <!-- 自绘标题栏:左标题,右图标按钮组(拖拽区交给 SetTitleBar) -->
        <Grid x:Name="AppTitleBar" Background="Transparent">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal"
                        VerticalAlignment="Center" Margin="16,0,8,0" Spacing="8">
                <!-- 品牌标:18×18 蓝底圆角 "A"(与 .ico 同款托盘蓝,纯文本非图片) -->
                <Border Width="18" Height="18" CornerRadius="5" Background="#285A96"
                        VerticalAlignment="Center">
                    <TextBlock Text="A" FontSize="11" FontWeight="SemiBold"
                               Foreground="White"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock x:Name="AppTitle" Text="AgentEye" FontSize="13"
                           FontWeight="SemiBold" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" />
                <!-- 状态胶囊:最紧张等级的点 + provider 数(ResultsChanged 时更新) -->
                <Border x:Name="StatusPill" CornerRadius="4" Padding="8,2"
                        Background="{ThemeResource AeSubtleFillBrush}"
                        VerticalAlignment="Center" Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal" Spacing="5">
                        <Ellipse x:Name="StatusDot" Width="6" Height="6"
                                 VerticalAlignment="Center" />
                        <TextBlock x:Name="StatusPillText" FontSize="11"
                                   Foreground="{ThemeResource AeTextSecondaryBrush}" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <StackPanel x:Name="HeaderButtons" Grid.Column="1" Orientation="Horizontal"
                        VerticalAlignment="Center" HorizontalAlignment="Right">
                <Button x:Name="BtnBack" Style="{StaticResource AeIconButtonStyle}"
                        Click="BtnBack_Click" Visibility="Collapsed">
                    <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}"
                              FontSize="14" Glyph="&#xE72B;" />
                </Button>
                <Button x:Name="BtnSettings" Style="{StaticResource AeIconButtonStyle}"
                        Click="BtnSettings_Click">
                    <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}"
                              FontSize="14" Glyph="&#xE713;" />
                </Button>
            </StackPanel>
        </Grid>

        <!-- 页面承载:总览/设置叠放,靠可见性切换 -->
        <Grid x:Name="PageHost" Grid.Row="1" />
    </Grid>
</Window>
