<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 头部图标按钮:32×32 透明底圆角 6,承载 FontIcon -->
    <Style x:Key="AeIconButtonStyle" TargetType="Button">
        <Setter Property="Width" Value="32" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="CornerRadius" Value="6" />
    </Style>

    <Style x:Key="AeSectionTitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="0,8,0,4" />
    </Style>

    <!-- 设置页:分节大标题(Windows 11 设置风格;420 宽面板用 16 号) -->
    <Style x:Key="AeSectionHeaderStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="0,12,0,6" />
    </Style>

    <!-- 设置页:一条功能 = 圆角卡片(图标 + 标题/副标题 + 右侧控件) -->
    <Style x:Key="AeSettingsItemStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource AeCardBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource AeCardStrokeBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="14,12" />
    </Style>

    <Style x:Key="AeSettingsItemTitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{ThemeResource AeTextPrimaryBrush}" />
    </Style>

    <Style x:Key="AeSettingsItemSubtitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{ThemeResource AeTextSecondaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="MaxLines" Value="2" />
    </Style>

    <!-- 卡片行图标底板:28×28 圆角坑位,字形收在 14 号 -->
    <Style x:Key="AeSettingsIconPlateStyle" TargetType="Border">
        <Setter Property="Width" Value="28" />
        <Setter Property="Height" Value="28" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Background" Value="{ThemeResource AeSubtleFillBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="AeSettingsIconGlyphStyle" TargetType="FontIcon">
        <Setter Property="FontFamily" Value="{ThemeResource SymbolThemeFontFamily}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{ThemeResource AeTextSecondaryBrush}" />
    </Style>
</ResourceDictionary>
